import numpy as np
from scipy.integrate import solve_ivp
import matplotlib.pyplot as plt

def cr3bp(t, z, mu):
    x, y, u, v = z   

    r1 = np.sqrt((x + 1 - mu)**2 + y**2)
    r2 = np.sqrt((x - mu)**2 + y**2)

    dOmega_dx = (
        -mu * (x + 1 - mu)
        - (1 - mu) * (x - mu)
        + mu * (x + 1 - mu) / r1**3
        + (1 - mu) * (x - mu) / r2**3
    )

    dOmega_dy = (
        -y
        + mu * y / r1**3
        + (1 - mu) * y / r2**3
    )

    dxdt = u
    dydt = v
    dudt = 2 * v - dOmega_dx
    dvdt = -2 * u - dOmega_dy

    return [dxdt, dydt, dudt, dvdt]

def Omega(x, y, mu):
    r1 = np.sqrt((x + 1 - mu)**2 + y**2)
    r2 = np.sqrt((x - mu)**2 + y**2)

    return (
        -0.5 * mu * r1**2
        -0.5 * (1 - mu) * r2**2
        - mu / r1
        - (1 - mu) / r2
    )

def J_constant(x, y, u, v, mu):
    return 0.5 * u**2 + 0.5 * v**2 + Omega(x, y, mu)

mu = 0.1
z0 = [0.5, 0.0, 0.0, 0.8]   
t_span = (0.0, 15.0)

t_eval = np.linspace(t_span[0], t_span[1], 5000)

sol = solve_ivp(
    cr3bp,
    t_span,
    z0,
    args=(mu,),
    method="RK45",
    t_eval=t_eval,
    rtol=1e-9,
    atol=1e-12
)

print("success:", sol.success)
print("message:", sol.message)

x = sol.y[0]
y = sol.y[1]
u = sol.y[2]
v = sol.y[3]

J = J_constant(x, y, u, v, mu)
J0 = J[0]

print("J(0) =", J0)
print("max |J(t)-J(0)| =", np.max(np.abs(J - J0)))
print("relative error =", np.max(np.abs(J - J0)) / max(1, abs(J0)))

plt.figure(figsize=(6, 6))
plt.plot(x, y, lw=1)
plt.scatter(-1 + mu, 0, c='red', label='body 1')
plt.scatter(mu, 0, c='blue', label='body 2')
plt.xlabel('x')
plt.ylabel('y')
plt.axis('equal')
plt.grid(True)
plt.legend()
plt.show()

plt.figure(figsize=(6, 4))
plt.plot(sol.t, J - J0)
plt.xlabel("t")
plt.ylabel(r"$J(t)-J(0)$")
plt.grid(True)
plt.show()